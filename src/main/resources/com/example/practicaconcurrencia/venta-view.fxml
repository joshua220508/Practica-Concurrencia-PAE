<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="570.0" prefWidth="720.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.practicaconcurrencia.controller.VentasController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <children>

        <Label text="Procesamiento Concurrente de Ventas">
            <VBox.margin>
                <Insets bottom="8.0"/>
            </VBox.margin>
        </Label>

        <VBox spacing="12.0">
            <children>

                <VBox spacing="5.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Vendedor 1" minWidth="100.0"/>
                                <ProgressBar fx:id="progresoVendedor1"
                                             prefWidth="450.0"
                                             progress="0.0"
                                             HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                        <Label fx:id="estadoVendedor1" text="Esperando..."/>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Vendedor 2" minWidth="100.0"/>
                                <ProgressBar fx:id="progresoVendedor2"
                                             prefWidth="450.0"
                                             progress="0.0"
                                             HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                        <Label fx:id="estadoVendedor2" text="Esperando..."/>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Vendedor 3" minWidth="100.0"/>
                                <ProgressBar fx:id="progresoVendedor3"
                                             prefWidth="450.0"
                                             progress="0.0"
                                             HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                        <Label fx:id="estadoVendedor3" text="Esperando..."/>
                    </children>
                </VBox>

            </children>
        </VBox>

        <Separator/>

        <HBox alignment="CENTER_LEFT" spacing="30.0">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="Ventas realizadas:"/>
                        <Label fx:id="lblVentasRealizadas" text="0"/>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="Total recaudado:"/>
                        <Label fx:id="lblTotalRecaudado" text="C$0"/>
                    </children>
                </HBox>

            </children>
        </HBox>

        <TextArea fx:id="txtResultados"
                  promptText="Aquí se mostrarán las ventas procesadas..."
                  prefHeight="160.0"
                  wrapText="true"
                  VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button fx:id="btnIniciar"
                        text="Iniciar ventas"
                        onAction="#iniciarVentas"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar"
                        onAction="#limpiar"/>
            </children>
        </HBox>

    </children>
</VBox>
